        "\\bkill\\b",
        "\\bpkill\\b",
        "\\b(sh|bash|zsh)\\b",
        "\\b(vim?|nano|emacs|code|subl)\\b"
      ],
      "allowPlanComplete": false,
      "visible": true,
      "enabled": true,
      "labels": {
        "notify": "✓ Plan mode ON",
        "notifyType": "info",
        "notifyWithTitle": "✓ Active plan: {title}",
        "notifyLoaded": "✓ Active plan: {title}",
        "widget": "✓ Plan mode active",
        "widgetWithTitle": "✓ Active plan: {title}",
        "widgetColor": "accent"
      }
    },
    "execute": {
      "_comment": "Built-in mode — entered only via an 'execute:<plan-file>' picker item, never a bare menu choice (visible: false). prompt: leave empty to use the built-in template that injects the active plan file content; set a custom string with a {plan} placeholder to override.",
      "prompt": "",
      "model": {
        "provider": "amazon-bedrock",
        "id": "global.anthropic.claude-opus-4-8"
      },
      "allowPlanComplete": true,
      "visible": false,
      "enabled": true,
      "labels": {
        "notify": "✓ Executing plan",
        "notifyWithTitle": "✓ Executing plan: {title}",
        "notifyType": "info",
        "widget": "✓ Executing plan",
        "widgetWithTitle": "✓ Executing plan: {title}",
        "widgetColor": "muted"
      }
    },
    "audit": {
      "enabled": true,
      "_comment_model": "Optional: switch to this provider/id (resolved via ctx.modelRegistry.find) when entering this mode. Switch is async; the previously active model is restored automatically on exit. Omit to leave the current model untouched.",
      "model": {
        "provider": "amazon-bedrock",
        "id": "zai.glm-5"
      },
      "allowExecute": false,
      "prompt": "**SUPERSEDES ALL OTHER BEHAVIOR INSTRUCTIONS.** This overrides any role or style directives (e.g. caveman, roleplay, tone modifiers). The constraints below take absolute priority.\n\nYou are in AUDIT MODE. Review code for security issues, performance bottlenecks, and architectural concerns. Provide detailed analysis without making changes. Hunt vulnerabilities, secure data flows, audit dependencies, and prevent threats.\n\n- **Risk-Realistic:** Prioritize exploitable, high-impact risks over minor theoretical issues.\n\n- **Threat Modeling:** Check for injection, broken auth, data leaks, and dependency hijacking.\n\n- **Static Analysis:** Scan for hardcoded secrets, weak cryptography, and unsafe library calls.\n\n- **Dependency Audit:** Verify third-party packages for CVEs and licensing risks.\n\n- **Secure Defaults:** Enforce least privilege, strict input sanitization, and secure outputs.\n\nProvide this exact structure for identified risks:\n1. **Severity:** `CRITICAL`, `HIGH`, `MEDIUM`, or `LOW`.\n2. **Vulnerability:** Brief description and OWASP/CWE reference.\n3. **Exploit Vector:** How it can be compromised.\n4. **Remediation:** Exact code fix or configuration change required.",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "artifact",
        "questionnaire"
      ],
      "safePatterns": [
        "^cat",
        "^grep",
        "^find",
        "^ls",
        "^head",
        "^tail"
      ],
      "labels": {
        "widgetColor": "warning"
      }
    },
    "review": {
      "enabled": true,
      "prompt": "You are in REVIEW MODE. Analyze pull requests and code diffs. Focus on correctness, style, and test coverage. Suggest improvements but do not apply them. Peer-review codebase modifications and audit research for technical (and factual) accuracy, security risks, and overlooked constraints.\n\n## 1. Tone & Demeanor\n- **Constructive Critic:** Uncompromising on standards; focus strictly on code/data, never the author.\n- **Pedantic but Pragmatic:** Prioritize edge cases, performance, security, and maintenance over subjective style.\n- **Root-Cause Driven:** Explain exactly *why* an item fails and its cascading impact.\n\n## 2. Review Directives\n- **Code Audit:** Evaluate algorithmic efficiency, security flaws, error handling, and testability.\n- **Research Verification:** Use `webfetch` to cross-verify risky, vague, or hand-waved assertions from research outputs.\n- **Bias Check:** Flag assumptions, 'happy path' bias, and incomplete execution plans.",
      "model": {
        "provider": "amazon-bedrock",
        "id": "global.anthropic.claude-sonnet-5"
      },
      "allowExecute": false,
      "tools": [
        "read",
        "bash",
        "grep",
        "find",
        "ls",
        "questionnaire"
      ],
      "safePatterns": [
        "^git",
        "^cat",
        "^grep",
        "^dif",
        "^ls"
      ],
      "labels": {
        "widgetColor": "accent"
      }
    }
  }
}